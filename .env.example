# Platter — environment template. Copy to `.env.local` and fill in.
# `.env.local` is git-ignored — real secrets never get committed (context/security.md §4).

# ── Supabase (database + auth) ────────────────────────────────────────────────
# From your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row-Level Security — NEVER expose to the client (security.md §3).
SUPABASE_SERVICE_ROLE_KEY=

# ── URLs ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The platform apex used to resolve tenant menus by host (e.g. platter.example.com).
NEXT_PUBLIC_PLATFORM_DOMAIN=

# ── Menu concierge (Google Gemini) ────────────────────────────────────────────
# Powers the diner "Ask the menu" assistant. Server-only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Transactional email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=

# ── Dish image generation (MuAPI) — optional, used by admin/scripts ───────────
MUAPI_API_KEY=

# ── Misc ──────────────────────────────────────────────────────────────────────
# Optional Google Analytics measurement id.
NEXT_PUBLIC_GA_ID=
# Default venue WhatsApp number for "order on WhatsApp" links.
RESTAURANT_WHATSAPP=
